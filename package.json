{
  "name": "radicalkjax-blog",
  "version": "1.0.0",
  "description": "Personal website and blog of Kali Jackson (radicalkjax.com), built with Jekyll.",
  "private": true,
  "scripts": {
    "start": "npm run slides && bundle exec jekyll serve --host 0.0.0.0 --port 4000",
    "build": "npm run slides && bundle exec jekyll build",
    "build:prod": "npm run slides && JEKYLL_ENV=production bundle exec jekyll build",
    "clean": "rm -rf _site .slides-dist .jekyll-cache .sass-cache",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint assets/js --ext .js --fix",
    "lint:css": "stylelint 'assets/css/**/*.css' --fix",
    "format": "prettier --write '**/*.{js,css,md,yml,json}'",
    "slides": "node scripts/build-slides.mjs",
    "slides:watch": "slidev projects/presentations/presentation.md --open",
    "slides:export": "slidev export projects/presentations/presentation.md --output .slides-dist/presentation.pdf",
    "slides:rekindle": "slidev projects/presentations/rekindle.md"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/radicalkjax/blog.git"
  },
  "keywords": [
    "jekyll",
    "blog",
    "github-pages",
    "personal-website"
  ],
  "author": "Kali Jackson <kali@radicalkjax.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/radicalkjax/blog/issues"
  },
  "homepage": "https://radicalkjax.com",
  "devDependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@slidev/cli": "^53.0.0",
    "eslint": "^8.56.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.0",
    "playwright-chromium": "^1.56.0",
    "prettier": "^3.1.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^35.0.0",
    "vue": "^3.5.0",
    "yaml": "^2.8.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.0.0"
  }
}
